{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {TraceId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": { "expression": "@l in ['Verbose', 'Debug']" }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "logs/debug-.json",
                  "formatter": {
                    "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
                    "template": "{ {timestamp: @t, level: @l, message: @m, service: service, environment: environment, trace_id: Coalesce(@tr, null), span_id: @sp, exception: @x, properties: rest()} }\n"
                  },
                  "rollingInterval": "Day",
                  "fileSizeLimitBytes": 104857600,
                  "rollOnFileSizeLimit": true,
                  "retainedFileCountLimit": null,
                  "retainedFileTimeLimit": "7.00:00:00"
                }
              }
            ]
          }
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/info-.json",
          "restrictedToMinimumLevel": "Information",
          "formatter": {
            "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "template": "{ {timestamp: @t, level: @l, message: @m, service: service, environment: environment, trace_id: Coalesce(@tr, null), span_id: @sp, exception: @x, properties: rest()} }\n"
          },
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": null,
          "retainedFileTimeLimit": "30.00:00:00"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/warning-.json",
          "restrictedToMinimumLevel": "Warning",
          "formatter": {
            "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "template": "{ {timestamp: @t, level: @l, message: @m, service: service, environment: environment, trace_id: Coalesce(@tr, null), span_id: @sp, exception: @x, properties: rest()} }\n"
          },
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": null,
          "retainedFileTimeLimit": "90.00:00:00"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/error-.json",
          "restrictedToMinimumLevel": "Error",
          "formatter": {
            "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "template": "{ {timestamp: @t, level: @l, message: @m, service: service, environment: environment, trace_id: Coalesce(@tr, null), span_id: @sp, exception: @x, properties: rest()} }\n"
          },
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": null,
          "retainedFileTimeLimit": "365.00:00:00"
        }
      }
    ]
  }
}
